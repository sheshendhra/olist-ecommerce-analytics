# Environment Configuration Template — Olist E-commerce Analytics (Sheshendra)
# Copy this file to .env for local overrides, or configure in Streamlit Community Cloud Secrets

# Application Environment
ENVIRONMENT=production
STREAMLIT_SERVER_PORT=8501

# Optional Managed PostgreSQL Connection
# If left empty, the application automatically uses the high-performance in-memory SQLite analytical engine
DATABASE_URL=postgresql://db_user:db_password@localhost:5432/olist_db
